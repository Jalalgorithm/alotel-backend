# ---------------------------------------------------------------------------
# Alotel Spaces Admin — environment template. Copy to `.env` and adjust.
# Every variable exposed to the client MUST be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix.
# Local Django dev server: http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Operational features (properties, bookings, financials) are not wired to the
# backend yet, so leave this "true" until their endpoints are integrated.
VITE_USE_MOCK=true

# Authentication has its own switch, so it can talk to the real API while the
# rest of the portal stays on mocks. Set "true" to develop auth offline.
VITE_USE_MOCK_AUTH=false

# Properties are wired to the real API independently of the rest of the
# catalogue. Set "true" to fall back to the local fixtures.
VITE_USE_MOCK_PROPERTIES=false

# Staff (Facility Manager / Housekeeper) accounts. Roles and the audit log
# stay on local mock data regardless of this flag.
VITE_USE_MOCK_PEOPLE=false

# Reservations and payment operations (refunds, deposits).
VITE_USE_MOCK_BOOKINGS=false
VITE_USE_MOCK_PAYMENTS=false
VITE_USE_MOCK_TAXES=false

# Simulated network latency (ms) for services still on mock mode.
VITE_MOCK_LATENCY=500

VITE_APP_NAME=Alotel Spaces Admin
